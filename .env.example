# Copy this file to .env.local (git-ignored) and fill in the values from
# Google Cloud → Google Auth Platform → Clients (project heroic-calculus-501703-e5).
# Vite embeds them in the build; they must never be committed.

# Desktop OAuth client used for Google Drive sync on Windows/Mac/Linux.
VITE_GDRIVE_CLIENT_ID=
VITE_GDRIVE_CLIENT_SECRET=

# Android OAuth client (only stored as a label; Android auth is matched by package + SHA-1).
VITE_GDRIVE_ANDROID_CLIENT_ID=
