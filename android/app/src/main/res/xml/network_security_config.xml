<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP only to this device, to zams's home PC and to that PC over Tailscale; everything
     else stays HTTPS-only (Android's default).
     - 127.0.0.1 / localhost: AnkiConnect for Android listens on http://127.0.0.1:8765.
     - 192.168.1.196: the home PC running Kavita (:5000) and Audiobookshelf (:13378). It needs a
       reserved address in the router; if it changes, update it here (native change: new APK).
     - desktop-go1ujdd.tail6db786.ts.net / 100.121.94.3: the same PC over Tailscale, running the
       Yoru sync server (:3747). Both forms are listed because the rule matches whichever of the
       two the app actually asks for. A .ts.net name does not resolve outside the tailnet, so
       this opens nothing to the outside. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">192.168.1.196</domain>
        <domain includeSubdomains="false">desktop-go1ujdd.tail6db786.ts.net</domain>
        <domain includeSubdomains="false">100.121.94.3</domain>
    </domain-config>
</network-security-config>
