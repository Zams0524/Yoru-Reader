{
  "appId": "com.yorureader.app",
  "appName": "YoruReader",
  "webDir": "dist",
  "loggingBehavior": "none",
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DARK"
    }
  },
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "accounts.google.com",
      "*.google.com",
      "*.googleapis.com"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  }
}
